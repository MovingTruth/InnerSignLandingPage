    },
    "inner-sign.index.text.0005": {
      "value": "سمائي",
      "sourceSha256": "e6ce26a3a1ae7daf33bc8899a067e791d7a3984d587865023bef58b892f40376"
    },
    "inner-sign.index.text.0006": {
      "value": "استكشف",
      "sourceSha256": "3b73900b8d29f963dece78edd4bd9529d855e50f2a3fcc39b3d66cd657630905"
    },
    "inner-sign.index.text.0007": {
      "value": "التوفر",
      "sourceSha256": "12f67f8539c46701e62d1c50254cf025c22a992b06fea6d4c0e19705f21f4cac"
    },
    "inner-sign.index.text.0008": {
      "value": "جميع التطبيقات",
      "sourceSha256": "01bed311e7d0c963a5f8afe3dd3c99c8140d887d92c602b94b9309fa51b32723"
    },
    "inner-sign.index.text.0009": {
      "value": "انظر إلى داخلك. انظر إلى الأعلى. تتبّع الصلة.",
      "sourceSha256": "54a7b75a7af0a2a48a75b83f0b5be12826ec619cfa37e1a3ae9c75042aa80f5b"
    },
    "inner-sign.index.text.0010": {
      "value": "انضم إلى الوصول المبكر",
      "sourceSha256": "ad15bb5a7b458a8929f40e30d83a46c78f3927e73890380ef79d3f2b4605ae00"
    },
    "inner-sign.index.text.0011": {
      "value": "اكتشف ما بداخله",
      "sourceSha256": "f93ebec1351e7cd3bff2df67bad375919e72451b9f355bfc43619fd7be1fbd2c"
    },
    "inner-sign.index.text.0012": {
      "value": "مرّر لتنظر إلى داخلك",
      "sourceSha256": "b4ed5666c45cf5c0b31b0ba239f822d532b4ec01203722f79f3ad38811950382"
    },
    "inner-sign.index.text.0013": {
      "value": "باب، لا حُكم.",
      "sourceSha256": "0f01da5039850af16d7993a6124906d950da431bcd53ab3fdcb8f9b524b9b1c2"
    },
    "inner-sign.index.text.0014": {
      "value": "يجمع Inner Sign التأمل الشخصي، والسماء التي يمكن رصدها، والقصة الإنسانية لعلم الفلك في مكان واحد مترابط. يقدّم أنماطًا للتأمل فيها، لا قواعد عمّن تكون أو عمّا يجب أن يحدث بعد ذلك.",
      "sourceSha256": "de1e3cfac3b5ab9352d74a1d0de006cba1b031f46dcb6825d6ba44977d7638de"
    },
    "inner-sign.index.text.0015": {
      "value": "القياس يسبق المعنى. يبقى كل خيط ظاهرًا.",
      "sourceSha256": "2d542cb2a5fbc14df1bf85db7a3b19c128fb782e06ac6d68a8446f7379cef106"
    },
    "inner-sign.index.text.0016": {
      "value": "اليوم",
      "sourceSha256": "2b065c7c9ce466e5ebcad757987d5d660ee4c9ea708bc62c43444b53334738ba"
    },
    "inner-sign.index.text.0017": {
      "value": "سمائي",
      "sourceSha256": "e6ce26a3a1ae7daf33bc8899a067e791d7a3984d587865023bef58b892f40376"
    },
    "inner-sign.index.text.0018": {
      "value": "استكشف",
      "sourceSha256": "3b73900b8d29f963dece78edd4bd9529d855e50f2a3fcc39b3d66cd657630905"
    },
    "inner-sign.index.text.0019": {
      "value": "تقويمك",
      "sourceSha256": "4606a66e61728dcd2e8219a649faa7eae8047ca3c3cef486c0204ad7730143e6"
    },
    "inner-sign.index.text.0020": {
      "value": "اليوم · انظر إلى داخلك",
      "sourceSha256": "145267c6b39670b7feb0dac3d81973d6d9a494e26f751e8e5f197d207083bca6"
    },
    "inner-sign.index.text.0021": {
      "value": "قراءة تخصك وتخص هذا اليوم.",
      "sourceSha256": "28522294a2ccfcd5bdb5241e333783195b0a68d33d67e47bd9cd450755192844"
    },
    "inner-sign.index.text.0022": {
      "value": "أعطِ Inner Sign تاريخ ميلاد واحدًا. يجمع أساسًا شخصيًا ثابتًا مع طابع اليوم المتغيّر، في تأمل قصير لك أن تأخذ به أو تتركه.",
      "sourceSha256": "e7972badc53e2a252d142fca2a17b7aa263aaa5f87693676def3040b43504b08"
    },
    "inner-sign.index.text.0023": {
      "value": "ثابت فيك",
      "sourceSha256": "73995a208209714a30dd1971a834e703a0aa3cb8b83b5cd0907042b7ffd9d322"
    },
    "inner-sign.index.text.0024": {
      "value": "برجك الشمسي وثلثه في Inner Sign، وحيوان برجك الصيني وعنصره.",
      "sourceSha256": "caac4d69264f9695061d5dadde53148e5d1e601008aa42c040a1181cf534e8f5"
    },
    "inner-sign.index.text.0025": {
      "value": "حيّ في اليوم",
      "sourceSha256": "bad119a91869f70e1f7487b9ac30935a2c2a9870602e6e898a95f5612133ee3c"
    },
    "inner-sign.index.text.0026": {
      "value": "العدد العام لليوم، مع عرض طريقة حسابه، وطور القمر الحالي.",
      "sourceSha256": "f2d0e8be9cbcff920ef96956ba445b598ae6f4128e12e1b5fa1523187f7968c7"
    },
    "inner-sign.index.text.0027": {
      "value": "متجدد، لا عشوائي",
      "sourceSha256": "cc6b4ed3452bc23865e0b08caf301cf42162fda095faf510e175a2bb4f8103ca"
    },
    "inner-sign.index.text.0028": {
      "value": "تاريخ الميلاد نفسه في اليوم نفسه يُعطي دائمًا القراءة نفسها.",
      "sourceSha256": "4079908bee1e063482b7f98e3452164e47f0a3b98f7cfd9ef3e11e11ea41cd31"
    },
    "inner-sign.index.text.0029": {
      "value": "كل جزء ينفتح على المزيد",
      "sourceSha256": "2f3324b27006cebca46b756fc09c865e99c055b4323b374dede3e44e209923b1"
    },
    "inner-sign.index.text.0030": {
      "value": "انقر على برج أو حيوان أو عدد اليوم أو القمر لفتح شرح أوفى. كل نتيجة لبرج أو كوكبة وأطوار القمر الثمانية كلها تُكمل إلى صفحة استكشف موثّقة المصادر؛ أما الصفحات الموثّقة لحيوانات الأبراج الصينية ولأعداد اليوم فلا تزال قيد الإضافة.",
      "sourceSha256": "459c544c72fe1e0e1b6e0acc4b854dca2d03cbd554e548de6e31cde63495dd8e"
    },
    "inner-sign.index.text.0031": {
      "value": "طريقتان لقراءة السماء",
      "sourceSha256": "4a1d4c11d3358a8c96d71d58842dc559ed31e741e8141d6ff0c0d48693483f4f"
    },
    "inner-sign.index.text.0032": {
      "value": "التقليدي 12. الفلكي 13.",
      "sourceSha256": "0b2c207148cd0ee5db582954b8b53ac52fac33dd0fcbbc545bb35d5b30f62e74"
    },
    "inner-sign.index.text.0033": {
      "value": "اقرأ برجك عبر دائرة البروج المألوفة ذات الاثني عشر برجًا، أو عبر الكوكبات الثلاث عشرة التي تعبرها الشمس فعلًا، ومنها الحوّاء. بدّل المنظور داخل أي قراءة وشاهد ما يتغيّر في يوم ميلادك. البرج وحده يتغيّر؛ ويبقى باقي القراءة ثابتًا.",
      "sourceSha256": "a684eccb872b4b064718585f21a53aeb11cba1d23975702de09b93b8a0a29f5f"
    },
    "inner-sign.index.text.0034": {
      "value": "لا يُقدَّم أي من المنظورين على أنه الحقيقة الوحيدة المُثبتة. الفضول هو الجوهر.",
      "sourceSha256": "b02a43ea08c363c47d581567167720629ac40624441e34ae91787ff492bf5b11"
    },
    "inner-sign.index.text.0035": {
      "value": "سمائي · انظر إلى الأعلى",
      "sourceSha256": "c1c42d0e4aff568c031c4be1d3f3f16fd32bd830a536e86898a6985eb6236dc3"
    },
    "inner-sign.index.text.0036": {
      "value": "السماء فوقك، محسوبة على جهازك.",
      "sourceSha256": "358f18e5410526773366daa27113bf7da599f128f2b15773db447ade216cbee7"
    },
    "inner-sign.index.text.0037": {
      "value": "اختر نقطة رصد، لقطة واحدة لموقعك أو مدينة من بين أكثر من 34,000 مدينة مخزّنة دون اتصال، ويحسب Inner Sign ما يستطيع من هناك، دون اتصال بالشبكة.",
      "sourceSha256": "1556f7fa990176b8b98da0814d840f644f2e36de224863b535b5166a83fefc6e"
    },
    "inner-sign.index.text.0038": {
      "value": "أين يقف قلب العقرب",
      "sourceSha256": "7861ca31e0df03f9dea924b292c2edf7538f5b291bf9c3d403ebc499a46ab910"
    },
    "inner-sign.index.text.0039": {
      "value": "قلب العقرب الأحمر الساطع: فوق أفقك أو تحته، وفي أي اتجاه، وعلى أي ارتفاع.",
      "sourceSha256": "9d5049b3acc141d191dfbcb04b7eaf9e86d7f6e2ca825ae118405f542049d350"
    },
    "inner-sign.index.text.0040": {
      "value": "العثور على أندروميدا",
      "sourceSha256": "39359de9822211aae5e6795f7dcc1770bc6d3f9cc33664779d4b29ae3a1f90a1"
    },
    "inner-sign.index.text.0041": {
      "value": "أين تقع M31، أقرب جاراتنا المجرّية الكبرى، في سمائك، وما الذي يتطلّبه فعلًا رؤية وهجها الخافت، وطريق مباشر إلى خريطة العثور عليها في استكشف.",
      "sourceSha256": "bc53d42546de1c67577a7acf8c1a43e56cbd570b8e756c9bb5cacd8596c955f0"
    },
    "inner-sign.index.text.0042": {
      "value": "عُمر الضوء",
      "sourceSha256": "87b22d2c9f0603f238d13168b8f6b5c80352d029148002bc76ec95b4fa95b25d"
    },
    "inner-sign.index.text.0043": {
      "value": "كم سافر ضوء الشمس الذي يصل إليك، والرحلة الكاملة لضوء القمر من الشمس إلى القمر ثم إليك، ونحو 2.5 مليون سنة قضاها ضوء أندروميدا حتى وصل إليك.",
      "sourceSha256": "5aeca9ba02bf47e787160da520a924a323ebcd43286f6f1b5066120cbb9af82e"
    },
    "inner-sign.index.text.0044": {
      "value": "كل كسوف وخسوف في السنة",
      "sourceSha256": "42342bb1fa8b7e86c33764241ebdace5e8cb308b7c64080e193658433598d456"
    },
    "inner-sign.index.text.0045": {
      "value": "الشمسية والقمرية، في العالم كله، مع جمع ما يُرى من نقطة رصدك أولًا.",
      "sourceSha256": "472ef0a0ad36e18ec141091313b9ceeaf9e2123c4fb05f37586368983d4718e6"
    },
    "inner-sign.index.text.0046": {
      "value": "منعطفات السنة",
      "sourceSha256": "e24b96dbbe2e7a23885e3a1aeef2435e36802d822d1bb2ba62107d6633c12973"
    },
    "inner-sign.index.text.0047": {
      "value": "كل طور رئيسي للقمر، والاعتدالان، والانقلابان للسنة التي تختارها.",
      "sourceSha256": "b05fd097f4af5332979907abf91d9adaf4ec437c385e0770fa7a04e052b59dbd"
    },
    "inner-sign.index.text.0048": {
      "value": "استكشف · تتبّع الصلة",
      "sourceSha256": "35f509fb93d61ae3753bbc2a462215e4c53a6492a1099454b1bb061d552d52ed"
    },
    "inner-sign.index.text.0049": {
      "value": "إحدى وعشرون كوكبة، مرسومة من المصادر.",
      "sourceSha256": "0abc2e9b9fc9200999ffee4a36ccf620781947ca6a4755a3239b3e713fbb87ca"
    },
    "inner-sign.index.text.0050": {
      "value": "الكوكبات الثلاث عشرة كلها على مسار الشمس، وثماني جارات أبعد منه: قيطس، والجبار، والكلب الأكبر، والدبّان، وذات الكرسي، والمرأة المسلسلة (أندروميدا)، والصليب الجنوبي. يُرسم كل دليل من مواقع نجوم مُفهرسة داخل حدوده الرسمية، ويُبيّن منذ متى يسافر ضوء كل نجم مختار، ويتضمن قائمة كاملة بالنجوم لمن يفضّل القراءة على النظر. وتُعلّم خريطة المرأة المسلسلة أيضًا مجرّة أندروميدا، M31.",
      "sourceSha256": "c23d19d029c1ccc0123b331df298e3166873e82912c78e8cefda1e392eaaba2a"
    },
    "inner-sign.index.text.0051": {
      "value": "خريطة معرفية تُظهر كيف ترتبط الكوكبات والأحداث والأشخاص والتقاليد، ومتاحة أيضًا في صورة قائمة بسيطة.",
      "sourceSha256": "607ad3d175555a421388a389884887e9b646eec247726c962493fec18b55e198"
    },
    "inner-sign.index.text.0052": {
      "value": "درس تفاعلي عن القمر: حرّك القمر حول الأرض وشاهد أطواره الثمانية كلها وهي تتكوّن.",
      "sourceSha256": "fcc54b4e66863b8d0bd2a992ed165feb50da726eea050c6911635f45e4434d09"
    },
    "inner-sign.index.text.0053": {
      "value": "القمر والفصول والانقلابات والاعتدالات، كلٌّ منها مشروح ومرتبط بمصادره.",
      "sourceSha256": "e1cd4318fd117ce3c06c5fd6e159440bfb60ba0748f1fa5a451cf3696a45ea73"
    },
    "inner-sign.index.text.0054": {
      "value": "علم الفلك والتاريخ والتقاليد الثقافية والتنجيم وتفسير Inner Sign الخاص، مع تسمية كل منها دائمًا بما هو عليه.",
      "sourceSha256": "b0c066bb13b0ea66c3c6dff1ef49d6e130a729b98d98258bbc556d6a17fdfa4f"
    },
    "inner-sign.index.text.0055": {
      "value": "تقويمك",
      "sourceSha256": "4606a66e61728dcd2e8219a649faa7eae8047ca3c3cef486c0204ad7730143e6"
    },
    "inner-sign.index.text.0056": {
      "value": "تواريخ السماء، فقط إن طلبتها.",
      "sourceSha256": "9438104218dada8cabae36353ecbfb5f52088292cdeee0943879132d3fc14e8d"
    },
    "inner-sign.index.text.0057": {
      "value": "اضبط تذكيرًا لحدث واحد، أو فعّل التنبيهات لأطوار القمر والفصول والكسوفات والخسوفات خلال السنة، أو أضف السنة كاملة بخطوة واحدة إلى تقويم Inner Sign منفصل في تطبيق التقويم من Apple. إضافته مرتين لا تُنشئ نسخًا مكررة، ولا يقرأ Inner Sign أحداثك الأخرى أبدًا.",
      "sourceSha256": "af6d3d08ac3aa6ec85c7336609bf08d4c4ad36af1fcbb1d850b1c6f8b2236386"
    },
    "inner-sign.index.text.0058": {
      "value": "صُمّم للوضوح والثقة",
      "sourceSha256": "53fdee2c427c8c5121dd16b6760bbc0e1f7cff564f188d96c28f1cc9d40ef3d0"
    },
    "inner-sign.index.text.0059": {
      "value": "لا شيء مخفي. لا شيء مأخوذ.",
      "sourceSha256": "0b1ffd4721a1989fc9ccb201325972e7983a69e85fc9baa7d03295aaa0322059"
    },
    "inner-sign.index.text.0060": {
      "value": "خاص منذ التصميم",
      "sourceSha256": "485ca594ccc9003ba4908cc7f0024a92ce2a89f2e3e49fb4acbc61770eff6580"
    },
    "inner-sign.index.text.0061": {
      "value": "يبقى تاريخ ميلادك والمدينة التي اخترتها على جهازك. لا يُحتفظ بلقطة الموقع إلا خلال الجلسة، فلا تُتتبّع ولا تُحفظ أبدًا. لا حسابات، ولا إعلانات، ولا تتبّع.",
      "sourceSha256": "2ad537b12802e373efb0b137771a1a841fa609b82f491c3a1254d8d5d7b64f81"
    },
    "inner-sign.index.text.0062": {
      "value": "مصادر يمكنك فحصها",
      "sourceSha256": "ef9757a37a74284f08da0f0001bb5f03672cbc9be75e524743f08d62129f5e43"
    },
    "inner-sign.index.text.0063": {
      "value": "ترتبط حسابات السماء والصفحات المعرفية بمصادرها، لتتمكّن من التحقق منها والمضيّ قُدمًا.",
      "sourceSha256": "5d769961791513ecbc5a31217b6ad1da78787d251068841072f8e7b45ef77354"
    },
    "inner-sign.index.text.0064": {
      "value": "صُمّم ليتكيّف",
      "sourceSha256": "e6bd2b61b5a2802604d3c4b17ad33e1f83b025c657dd31e296b043c5129c199c"
    },
    "inner-sign.index.text.0065": {
      "value": "VoiceOver، ونص أكبر، وتباين أعلى، وحركة أقل، وبدائل مقروءة لكل خريطة.",
      "sourceSha256": "4ce09bdcaf7bb01a756adaa696604eef158bc48638625f8c868b3aaffde9234b"
    },
    "inner-sign.index.text.0066": {
      "value": "معادلة في العلن",
      "sourceSha256": "435874d5b03742f970cd81dcc0436e6da23b183adf79925f7097da2855ff7577"
    },
    "inner-sign.index.text.0067": {
      "value": "طريقة بناء القراءة، بالمنظورين معًا والأثلاث وعدد اليوم والأبراج الصينية والقمر، منشورة ومُختبرة.",
      "sourceSha256": "088db018f9167688d26a22c37d6743ea78664a8e7a71dfb905b5c821972fc489"
    },
    "inner-sign.index.text.0068": {
      "value": "اقرأ المعادلة بنفسك",
      "sourceSha256": "e76932ff254ef186abc14244ea46dc42897781581fe75d9c46ef92999ac31897"
    },
    "inner-sign.index.text.0069": {
      "value": "نية لـ Inner Sign",
      "sourceSha256": "f3cb50e5793d4c150eabc4579c6e97535ca09a1261e0d262c7eb4eae8979039e"
    },
    "inner-sign.index.text.0070": {
      "value": "لعل كل منظور يوسّع الفضول من دون أن يضيّق الحقيقة.",
      "sourceSha256": "ee9b78afca463289cd09058120d4fafa0788f3ff922de62a8230a925670359ea"
    },
    "inner-sign.index.text.0071": {
